{
    "name": "@zenbase/sdk",
    "version": "1.0.0",
    "description": "SDK officiel JavaScript / TypeScript & Node.js pour Zenbase BaaS (Database NoSQL, Auth, Storage, Serverless PHP Functions)",
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "src",
        "docs",
        "README.md"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "typecheck": "tsc -p tsconfig.json --noEmit"
    },
    "keywords": [
        "zenbase",
        "baas",
        "sdk",
        "nosql",
        "sqlite",
        "laravel",
        "nodejs",
        "typescript"
    ],
    "license": "MIT"
}
